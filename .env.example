# LLM Provider Configuration
# Choose one of: openai, gemini, groq
LLM_PROVIDER=openai

# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-5.4-nano

# Google Gemini API Key (if using Google Gemini)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash

# Groq API Key (if using Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Application Settings
DATABASE_PATH=sqlite:///restaurant.db
VECTOR_STORE_DIR=./data/chroma_db
TAX_RATE=0.08
DELIVERY_FEE=3.99
RESTAURANT_NAME="FlavorCraft Bistro"
RESTAURANT_PHONE="+1 (555) 234-5678"
RESTAURANT_HOURS="Mon-Sun: 10:00 AM - 11:00 PM"
